{
  "meta": {
    "name": "Roadmap Labs Design System",
    "version": "1.2.0",
    "theme": "Mono (black and white)",
    "date": "2026-10-25",
    "note": "Typeface locked by Dan on 25 Oct 2026: Inter Display (Inter 4 variable, opsz axis) with JetBrains Mono for labels. Files in assets/fonts."
  },
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "bg-subtle": "#F7F7F8",
      "text": "#0B0D12",
      "text-secondary": "#5B616E",
      "text-tertiary": "#8B919C",
      "rule": "#E6E8EC",
      "rule-strong": "#D5D8DE",
      "action": "#0B0D12",
      "action-hover": "#262932",
      "action-active": "#000000",
      "action-text": "#FFFFFF",
      "disabled-bg": "#E6E8EC",
      "disabled-text": "#8B919C",
      "link": "#0B0D12",
      "link-underline": "rgba(11,13,18,0.35)",
      "focus": "#0B0D12"
    },
    "dark": {
      "bg": "#0B0D12",
      "bg-subtle": "#15181F",
      "text": "#F4F5F7",
      "text-secondary": "#9AA0AA",
      "text-tertiary": "#6B717C",
      "rule": "rgba(255,255,255,0.12)",
      "rule-strong": "rgba(255,255,255,0.20)",
      "action": "#FFFFFF",
      "action-hover": "#E6E8EC",
      "action-active": "#D5D8DE",
      "action-text": "#0B0D12",
      "disabled-bg": "rgba(255,255,255,0.12)",
      "disabled-text": "#6B717C",
      "link": "#F4F5F7",
      "link-underline": "rgba(244,245,247,0.40)",
      "focus": "#FFFFFF"
    },
    "palette": {
      "white": "#FFFFFF",
      "paper": "#F7F7F8",
      "ink": "#0B0D12",
      "ink-800": "#15181F",
      "ink-700": "#262932",
      "grey-600": "#5B616E",
      "grey-500": "#6B717C",
      "grey-400": "#8B919C",
      "grey-350": "#9AA0AA",
      "grey-200": "#D5D8DE",
      "grey-100": "#E6E8EC",
      "black": "#000000"
    }
  },
  "font": {
    "family": {
      "sans": "\"Inter Display\", \"Inter\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "variable": {
      "sans": "--font-sans",
      "mono": "--font-mono"
    },
    "opticalSizing": "auto",
    "opsz": {
      "min": 14,
      "max": 32,
      "note": "Inter 4 opsz axis. With font-optical-sizing:auto the browser sets opsz = font-size in px, clamped 14 to 32, so text 32px and up renders the Inter Display cut (opsz 32) and 14px text renders the text cut. Do not set font-variation-settings for opsz: it inherits and would force one cut onto every size."
    },
    "features": {
      "sans": "normal",
      "mono": "\"calt\" 0",
      "note": "Mono: contextual alternates off so JetBrains Mono code ligatures never form in labels. Sans: Inter defaults, no stylistic sets (the approved comparison rendered without them)."
    },
    "files": {
      "sans": "assets/fonts/InterVariable.woff2",
      "mono": "assets/fonts/JetBrainsMono-Variable.woff2",
      "og-display": "assets/fonts/InterDisplay-SemiBold-600.ttf",
      "og-mono": "assets/fonts/JetBrainsMono-Regular-400.ttf"
    }
  },
  "type": {
    "display": {
      "desktop": "80px",
      "tablet": "56px",
